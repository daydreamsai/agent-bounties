# ============================================================
# Approval Risk Auditor —— 环境变量
# 复制为 .env.local（本地）或在 Vercel 上配置（生产）
# ============================================================

# --- x402 支付（agent-kit 自动挂载 x402-hono 中间件）---
# 默认 facilitator 就是 daydreamsai 官方的，一般不用改
FACILITATOR_URL=https://facilitator.daydreams.systems
# 收款地址（USDC，base-sepolia）。留空则不启用 paywall（仅本地调试用）
ADDRESS=
# 支付网络
NETWORK=base-sepolia
# ⚠️ price 单位是 **美元**，链上会 ×10^6（USDC 6 位小数）
#    0.0025 = $0.0025/次（2500 atomic units）；写成 2500 会变成 2500 美元/次！
DEFAULT_PRICE=0.0025
# 可选：单独给 audit 入口定价（同上单位）
ENTRYPOINT_PRICE=

# --- 数据源 ---
# 可选：配置后自动切到 etherscan 模式（多链 + 全历史，与 Etherscan 完全对齐）
ETHERSCAN_API_KEY=
# 可选：自定义 RPC（逗号分隔，按顺序故障转移）
AUDIT_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth-mainnet.public.blastapi.io,https://rpc.ankr.com/eth
# 可选：公共 API 上报自己的钱包用于统计（默认不上报）
TELEMETRY_OPT_IN=0

# --- 服务 ---
PORT=8788
HOST=0.0.0.0
