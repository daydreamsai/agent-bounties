# Required: Wallet address for receiving x402 payments
ADDRESS=0xYourWalletAddressHere

# Optional: Payment network (default: base-sepolia)
NETWORK=base-sepolia

# Optional: Default price in smallest unit (default: 1000)
DEFAULT_PRICE=1000

# Optional: Custom RPC URLs (defaults to public llamarpc endpoints)
# ETH_RPC_URL=https://eth.llamarpc.com
# BASE_RPC_URL=https://base.llamarpc.com
# ARB_RPC_URL=https://arbitrum.llamarpc.com
# POLYGON_RPC_URL=https://polygon.llamarpc.com
# OP_RPC_URL=https://optimism.llamarpc.com
# BSC_RPC_URL=https://bsc.llamarpc.com
